{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "maxDuration": 60
        }
  },
  "routes": [
    {
      "src": "^/$",
      "headers": {
        "Location": "/geo_admin"
      },
      "status": 307
    },
    {
      "src": "/(assets|build|css|fonts|images|js|previews|themes|uploads|vendor)/(.*)",
      "dest": "/public/$1/$2"
    },
    {
      "src": "/(favicon\\.ico|robots\\.txt)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
